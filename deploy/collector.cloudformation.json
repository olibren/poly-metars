{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Isolated Poly METARs collector, evidence backups and HTTPS origin",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "SubnetId": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "ImageId": {
      "Type": "AWS::EC2::Image::Id"
    },
    "CloudFrontPrefixList": {
      "Type": "String"
    },
    "CommitSha": {
      "Type": "String",
      "AllowedPattern": "[a-f0-9]{40}"
    }
  },
  "Resources": {
    "Evidence": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "poly-metars-evidence-${AWS::AccountId}-${AWS::Region}"
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "poly-metars"
          }
        ]
      }
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "poly-metars-collector",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        ],
        "Policies": [
          {
            "PolicyName": "project-evidence-only",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Evidence",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Evidence.Arn}/*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Profile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "Role"
          }
        ]
      }
    },
    "Firewall": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Poly METARs readonly HTTP from CloudFront only; no SSH",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "SourcePrefixListId": {
              "Ref": "CloudFrontPrefixList"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "poly-metars-collector"
          },
          {
            "Key": "Project",
            "Value": "poly-metars"
          }
        ]
      }
    },
    "Collector": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "ImageId"
        },
        "InstanceType": "t4g.small",
        "SubnetId": {
          "Ref": "SubnetId"
        },
        "IamInstanceProfile": {
          "Ref": "Profile"
        },
        "SecurityGroupIds": [
          {
            "Ref": "Firewall"
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled"
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeSize": 40,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": false
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "poly-metars-collector"
          },
          {
            "Key": "Project",
            "Value": "poly-metars"
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Sub": "#!/bin/bash\nset -euo pipefail\ndnf install -y git\nprintf 'POLY_METARS_BACKUP_BUCKET=%s\\n' '${Evidence}' > /etc/poly-metars-backup\ngit clone https://github.com/olibren/poly-metars.git /opt/poly-metars\ncd /opt/poly-metars\ngit checkout '${CommitSha}'\n# The bootstrap reuses this exact checkout.\nbash deploy/bootstrap.sh\n"
          }
        }
      }
    },
    "Address": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc",
        "InstanceId": {
          "Ref": "Collector"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "poly-metars"
          }
        ]
      }
    },
    "Delivery": {
      "Type": "AWS::CloudFront::Distribution",
      "DependsOn": "Address",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "Poly METARs public government evidence origin",
          "PriceClass": "PriceClass_100",
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "Origins": [
            {
              "Id": "collector",
              "DomainName": {
                "Fn::GetAtt": [
                  "Collector",
                  "PublicDnsName"
                ]
              },
              "CustomOriginConfig": {
                "HTTPPort": 80,
                "HTTPSPort": 443,
                "OriginProtocolPolicy": "http-only",
                "OriginReadTimeout": 60
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "collector",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad"
          },
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          }
        }
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "Collector"
      }
    },
    "EvidenceBucket": {
      "Value": {
        "Ref": "Evidence"
      }
    },
    "CollectorUrl": {
      "Value": {
        "Fn::Sub": "https://${Delivery.DomainName}"
      }
    },
    "DistributionId": {
      "Value": {
        "Ref": "Delivery"
      }
    }
  }
}
