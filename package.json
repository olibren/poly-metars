{
  "name": "poly-metars",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "python3 -m http.server 8000 --directory dist/client",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "python3 -m unittest discover -s tests -v",
    "check": "tsc --noEmit && tsc --noEmit -p cloudflare/tsconfig.json",
    "prepare-public": "python3 scripts/prepare_public.py",
    "prebuild": "npm run prepare-public",
    "cf:prepare": "python3 scripts/prepare_cloudflare.py",
    "cf:dev": "npm run cf:prepare && uv run pywrangler dev --config wrangler.collector.jsonc",
    "cf:types": "wrangler types cloudflare/site-env.d.ts --config wrangler.site.jsonc --env-interface SiteEnv",
    "cf:deploy": "npm run cf:prepare && uv run pywrangler deploy --config wrangler.collector.jsonc && wrangler deploy --config wrangler.site.jsonc",
    "cf:dry-run": "npm run cf:prepare && uv run pywrangler deploy --config wrangler.collector.jsonc --dry-run && wrangler deploy --dry-run --config wrangler.site.jsonc"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wrangler": "4.136.2"
  },
  "type": "module"
}
